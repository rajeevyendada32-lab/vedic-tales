<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= book.title %> | Vedic Tales</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Lora', serif; background: #faf6ef; color: #3e2723; padding: 0; }
        header { background: linear-gradient(135deg, #fdfbf7 0%, #f4ebd9 100%); border-bottom: 1px solid #d7ccc8; padding: 30px 40px; }
        .header-inner { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
        .brand { font-family: 'Cinzel', serif; font-size: 24px; font-weight: 700; color: #6d4c41; letter-spacing: 3px; text-decoration: none; }
        .cart-link { background: #6d4c41; color: #fdfbf7; padding: 12px 24px; border-radius: 2px; text-decoration: none; font-size: 14px; letter-spacing: 1px; transition: all 0.3s; }
        .cart-link:hover { background: #3e2723; }
        
        .container { max-width: 1000px; margin: 60px auto; padding: 0 40px; }
        .back { color: #8d6e63; text-decoration: none; font-size: 13px; letter-spacing: 2px; text-transform: uppercase; display: inline-block; margin-bottom: 30px; transition: color 0.3s; }
        .back:hover { color: #4e342e; }
        
        .book-layout { display: flex; gap: 60px; flex-wrap: wrap; background: #fff; border: 1px solid #e8ddd0; border-radius: 4px; padding: 50px; box-shadow: 0 4px 24px rgba(109,76,65,0.08); }
        .book-layout img { width: 320px; height: 440px; object-fit: cover; border-radius: 4px; box-shadow: 0 12px 32px rgba(78,52,46,0.25); }
        .book-info { flex: 1; min-width: 280px; }
        .category { display: inline-block; font-size: 11px; letter-spacing: 3px; color: #8d6e63; text-transform: uppercase; margin-bottom: 20px; border-bottom: 1px solid #d7ccc8; padding-bottom: 8px; }
        .book-info h1 { font-family: 'Cinzel', serif; font-size: 32px; color: #4e342e; margin-bottom: 25px; line-height: 1.3; letter-spacing: 1px; }
        .description { line-height: 1.9; color: #5d4037; font-size: 16px; margin-bottom: 30px; font-style: italic; }
        .price { font-family: 'Cinzel', serif; font-size: 34px; font-weight: 700; color: #6d4c41; margin-bottom: 30px; }
        .btn { display: inline-block; background: #6d4c41; color: #fdfbf7; padding: 16px 40px; border-radius: 2px; text-decoration: none; font-size: 14px; letter-spacing: 3px; text-transform: uppercase; border: none; cursor: pointer; transition: all 0.3s; font-family: 'Lora', serif; }
        .btn:hover { background: #3e2723; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(78,52,46,0.3); }
        footer { text-align: center; padding: 40px 20px; margin-top: 60px; border-top: 1px solid #e8ddd0; color: #8d6e63; font-size: 13px; letter-spacing: 2px; }
    </style>
</head>
<body>
    <header>
        <div class="header-inner">
            <a href="/" class="brand">VEDIC TALES</a>
            <a href="/cart" class="cart-link">🛒 CART (<%= cartCount %>)</a>
        </div>
    </header>

    <div class="container">
        <a href="/" class="back">← Back to Collection</a>
        <div class="book-layout">
            <img src="<%= book.coverImage %>" alt="<%= book.title %>">
            <div class="book-info">
                <span class="category"><%= book.category %></span>
                <h1><%= book.title %></h1>
                <p class="description"><%= book.description %></p>
                <p class="price">₹<%= book.price %></p>
                <form action="/add-to-cart/<%= book._id %>" method="POST">
                    <button type="submit" class="btn">Add to Cart</button>
                </form>
            </div>
        </div>
    </div>

    <footer>© VEDIC TALES · HANDCRAFTED WITH DEVOTION</footer>
</body>
</html>
