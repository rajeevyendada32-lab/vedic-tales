<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Order Confirmed | Vedic Tales</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Lora', serif; background: #faf6ef; color: #3e2723; padding: 0; }
        header { background: linear-gradient(135deg, #fdfbf7 0%, #f4ebd9 100%); border-bottom: 1px solid #d7ccc8; padding: 30px 40px; }
        .header-inner { max-width: 1200px; margin: 0 auto; text-align: center; }
        .brand { font-family: 'Cinzel', serif; font-size: 24px; font-weight: 700; color: #6d4c41; letter-spacing: 3px; text-decoration: none; }
        
        .container { max-width: 750px; margin: 60px auto; padding: 50px; background: #fff; border: 1px solid #e8ddd0; border-radius: 4px; box-shadow: 0 4px 24px rgba(109,76,65,0.08); text-align: center; }
        
        .checkmark-circle { width: 80px; height: 80px; border-radius: 50%; background: #f4ebd9; border: 2px solid #6d4c41; display: flex; align-items: center; justify-content: center; margin: 0 auto 30px; font-size: 36px; color: #6d4c41; }
        
        h1 { font-family: 'Cinzel', serif; font-size: 32px; color: #4e342e; margin-bottom: 15px; letter-spacing: 2px; }
        .subtitle { color: #8d6e63; font-style: italic; font-size: 16px; margin-bottom: 40px; }
        .divider { width: 80px; height: 2px; background: #bcaaa4; margin: 0 auto 40px; }
        
        .order-details { background: #fdfbf7; border: 1px solid #e8ddd0; border-radius: 4px; padding: 30px; margin: 30px 0; text-align: left; }
        .order-details h3 { font-family: 'Cinzel', serif; font-size: 16px; color: #4e342e; margin-bottom: 20px; letter-spacing: 2px; border-bottom: 1px solid #e8ddd0; padding-bottom: 12px; }
        .order-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f0e8dc; font-size: 14px; color: #5d4037; }
        .order-row:last-child { border-bottom: none; }
        .order-row span:first-child { color: #8d6e63; }
        
        .total { font-family: 'Cinzel', serif; font-size: 22px; font-weight: 700; color: #6d4c41; margin-top: 20px; padding-top: 20px; border-top: 2px solid #bcaaa4; text-align: right; letter-spacing: 1px; }
        
        .note { background: #f4ebd9; border-left: 3px solid #6d4c41; padding: 20px; margin: 30px 0; text-align: left; color: #5d4037; font-size: 14px; line-height: 1.7; font-style: italic; }
        
        .btn { display: inline-block; background: #6d4c41; color: #fdfbf7; padding: 16px 40px; border-radius: 2px; text-decoration: none; font-size: 14px; letter-spacing: 3px; text-transform: uppercase; transition: all 0.3s; font-family: 'Lora', serif; }
        .btn:hover { background: #3e2723; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(78,52,46,0.3); }
        
        footer { text-align: center; padding: 40px 20px; color: #8d6e63; font-size: 13px; letter-spacing: 2px; }
    </style>
</head>
<body>
    <header>
        <div class="header-inner">
            <a href="/" class="brand">VEDIC TALES</a>
        </div>
    </header>

    <div class="container">
        <div class="checkmark-circle">✓</div>
        <h1>Order Confirmed</h1>
        <p class="subtitle">Thank you, <%= order.name %></p>
        <div class="divider"></div>

        <div class="order-details">
            <h3>Order Summary</h3>
            <% order.books.forEach(book => { %>
                <div class="order-row">
                    <span><%= book.title %></span>
                    <span>₹<%= book.price %></span>
                </div>
            <% }); %>
            <div class="total">Total: ₹<%= order.total %></div>
        </div>

        <div class="order-details">
            <h3>Delivery Details</h3>
            <div class="order-row"><span>Name</span><span><%= order.name %></span></div>
            <div class="order-row"><span>Email</span><span><%= order.email %></span></div>
            <div class="order-row"><span>Phone</span><span><%= order.phone %></span></div>
            <div class="order-row"><span>Address</span><span><%= order.address %></span></div>
        </div>

        <div class="note">
            📩 We will contact you shortly to confirm payment and shipping details.
        </div>

        <a href="/" class="btn">Continue Shopping</a>
    </div>

    <footer>© VEDIC TALES · HANDCRAFTED WITH DEVOTION</footer>
</body>
</html>
