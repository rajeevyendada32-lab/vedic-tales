<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Checkout | Vedic Tales</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Lora', serif; background: #faf6ef; color: #3e2723; padding: 0; }
        header { background: linear-gradient(135deg, #fdfbf7 0%, #f4ebd9 100%); border-bottom: 1px solid #d7ccc8; padding: 30px 40px; }
        .header-inner { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
        .brand { font-family: 'Cinzel', serif; font-size: 24px; font-weight: 700; color: #6d4c41; letter-spacing: 3px; text-decoration: none; }
        
        .container { max-width: 1100px; margin: 60px auto; padding: 0 40px; }
        .back { color: #8d6e63; text-decoration: none; font-size: 13px; letter-spacing: 2px; text-transform: uppercase; display: inline-block; margin-bottom: 20px; }
        .back:hover { color: #4e342e; }
        h1 { font-family: 'Cinzel', serif; font-size: 32px; color: #4e342e; margin-bottom: 30px; letter-spacing: 2px; }
        
        .layout { display: flex; gap: 40px; flex-wrap: wrap; }
        .form-section { flex: 1.2; min-width: 320px; background: #fff; border: 1px solid #e8ddd0; border-radius: 4px; padding: 40px; box-shadow: 0 4px 24px rgba(109,76,65,0.08); }
        .summary-section { flex: 1; min-width: 280px; background: linear-gradient(135deg, #fdfbf7 0%, #f4ebd9 100%); border: 1px solid #e8ddd0; border-radius: 4px; padding: 40px; height: fit-content; }
        
        .form-section h2, .summary-section h2 { font-family: 'Cinzel', serif; font-size: 18px; color: #4e342e; margin-bottom: 25px; letter-spacing: 2px; border-bottom: 1px solid #e8ddd0; padding-bottom: 15px; }
        
        label { display: block; margin: 20px 0 8px; font-size: 12px; letter-spacing: 2px; color: #6d4c41; text-transform: uppercase; }
        input, textarea { width: 100%; padding: 14px 16px; border: 1px solid #d7ccc8; border-radius: 2px; font-family: 'Lora', serif; font-size: 15px; background: #fdfbf7; transition: border 0.3s; color: #3e2723; }
        input:focus, textarea:focus { outline: none; border-color: #6d4c41; background: #fff; }
        textarea { height: 100px; resize: vertical; }
        
        .summary-item { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #e8ddd0; font-size: 14px; color: #5d4037; }
        .summary-item:last-of-type { border-bottom: none; }
        .total { display: flex; justify-content: space-between; font-family: 'Cinzel', serif; font-size: 22px; font-weight: 700; color: #6d4c41; margin-top: 20px; padding-top: 20px; border-top: 2px solid #bcaaa4; letter-spacing: 1px; }
        
        .btn { display: block; width: 100%; background: #6d4c41; color: #fdfbf7; padding: 18px; border: none; border-radius: 2px; font-size: 14px; cursor: pointer; margin-top: 30px; letter-spacing: 4px; text-transform: uppercase; transition: all 0.3s; font-family: 'Lora', serif; }
        .btn:hover { background: #3e2723; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(78,52,46,0.3); }
        
        footer { text-align: center; padding: 40px 20px; margin-top: 60px; color: #8d6e63; font-size: 13px; letter-spacing: 2px; }
    </style>
</head>
<body>
    <header>
        <div class="header-inner">
            <a href="/" class="brand">VEDIC TALES</a>
        </div>
    </header>

    <div class="container">
        <a href="/cart" class="back">← Back to Cart</a>
        <h1>Checkout</h1>

        <div class="layout">
            <div class="form-section">
                <h2>Delivery Details</h2>
                <form action="/place-order" method="POST">
                    <label>Full Name</label>
                    <input type="text" name="name" required placeholder="Your full name">

                    <label>Email</label>
                    <input type="email" name="email" required placeholder="you@example.com">

                    <label>Phone Number</label>
                    <input type="tel" name="phone" required placeholder="+91 98765 43210">

                    <label>Shipping Address</label>
                    <textarea name="address" required placeholder="Full address with pincode"></textarea>

                    <button type="submit" class="btn">Place Order</button>
                </form>
            </div>

            <div class="summary-section">
                <h2>Order Summary</h2>
                <% books.forEach(book => { %>
                    <div class="summary-item">
                        <span><%= book.title %></span>
                        <span>₹<%= book.price %></span>
                    </div>
                <% }); %>
                <div class="total">
                    <span>Total</span>
                    <span>₹<%= total %></span>
                </div>
            </div>
        </div>
    </div>

    <footer>© VEDIC TALES · HANDCRAFTED WITH DEVOTION</footer>
</body>
</html>
