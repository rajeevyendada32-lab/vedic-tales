<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Vedic Tales | Premium Bookstore</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Lora', serif; background: #faf6ef; color: #3e2723; }
        header { background: linear-gradient(135deg, #fdfbf7 0%, #f4ebd9 100%); border-bottom: 1px solid #d7ccc8; padding: 30px 40px; }
        .header-inner { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
        .brand { font-family: 'Cinzel', serif; font-size: 28px; font-weight: 700; color: #6d4c41; letter-spacing: 3px; }
        .brand-sub { font-size: 11px; color: #8d6e63; letter-spacing: 4px; margin-top: 4px; }
        .cart-link { background: #6d4c41; color: #fdfbf7; padding: 12px 24px; border-radius: 2px; text-decoration: none; font-size: 14px; letter-spacing: 1px; transition: all 0.3s; }
        .cart-link:hover { background: #3e2723; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(109,76,65,0.3); }
        
        .hero { text-align: center; padding: 60px 20px 30px; }
        .hero h1 { font-family: 'Cinzel', serif; font-size: 42px; color: #4e342e; letter-spacing: 2px; margin-bottom: 15px; }
        .hero p { font-style: italic; color: #8d6e63; font-size: 16px; letter-spacing: 1px; }
        .divider { width: 80px; height: 2px; background: #bcaaa4; margin: 25px auto; }
        
        .search-bar { max-width: 600px; margin: 0 auto 40px; padding: 0 40px; }
        .search-form { display: flex; gap: 10px; }
        .search-form input { flex: 1; padding: 14px 20px; border: 1px solid #d7ccc8; border-radius: 2px; font-family: 'Lora', serif; font-size: 15px; background: #fff; color: #3e2723; }
        .search-form input:focus { outline: none; border-color: #6d4c41; }
        .search-form button { background: #6d4c41; color: #fdfbf7; border: none; padding: 14px 28px; border-radius: 2px; font-size: 13px; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; transition: all 0.3s; font-family: 'Lora', serif; }
        .search-form button:hover { background: #3e2723; }
        .search-info { text-align: center; color: #8d6e63; font-style: italic; margin-bottom: 20px; font-size: 14px; }
        
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; max-width: 1200px; margin: 20px auto 80px; padding: 0 40px; }
        .book { background: #fff; border: 1px solid #e8ddd0; border-radius: 4px; overflow: hidden; transition: all 0.4s ease; box-shadow: 0 2px 12px rgba(109,76,65,0.06); }
        .book:hover { transform: translateY(-8px); box-shadow: 0 16px 40px rgba(109,76,65,0.18); border-color: #bcaaa4; }
        .book a { text-decoration: none; color: inherit; display: block; }
        .book-img-wrap { overflow: hidden; background: #f4ebd9; }
        .book img { width: 100%; height: 380px; object-fit: cover; transition: transform 0.6s ease; display: block; }
        .book:hover img { transform: scale(1.05); }
        .book-info { padding: 24px; text-align: center; }
        .book-category { font-size: 11px; letter-spacing: 3px; color: #8d6e63; text-transform: uppercase; margin-bottom: 10px; }
        .book h3 { font-family: 'Cinzel', serif; font-size: 18px; color: #4e342e; margin-bottom: 12px; line-height: 1.4; font-weight: 600; }
        .price { font-family: 'Cinzel', serif; font-size: 20px; color: #6d4c41; font-weight: 700; margin-bottom: 18px; }
        .btn { display: inline-block; background: #6d4c41; color: #fdfbf7; padding: 12px 24px; border-radius: 2px; text-decoration: none; border: none; cursor: pointer; font-size: 13px; letter-spacing: 2px; text-transform: uppercase; transition: all 0.3s; font-family: 'Lora', serif; }
        .btn:hover { background: #3e2723; }
        .btn-outline { background: transparent; color: #6d4c41; border: 1px solid #6d4c41; }
        .btn-outline:hover { background: #6d4c41; color: #fdfbf7; }
        .actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
        .actions form { display: inline; }
        .no-results { text-align: center; padding: 60px 20px; color: #8d6e63; font-style: italic; font-size: 18px; grid-column: 1 / -1; }
        footer { text-align: center; padding: 40px 20px; border-top: 1px solid #e8ddd0; color: #8d6e63; font-size: 13px; letter-spacing: 2px; }
    </style>
</head>
<body>
    <header>
        <div class="header-inner">
            <div>
                <div class="brand">VEDIC TALES</div>
                <div class="brand-sub">PREMIUM MAHABHARATA COLLECTION</div>
            </div>
            <a href="/cart" class="cart-link">🛒 CART (<%= cartCount %>)</a>
        </div>
    </header>

    <div class="hero">
        <h1>The Epic Collection</h1>
        <div class="divider"></div>
        <p>Timeless stories from the Mahabharata, illustrated for the modern reader</p>
    </div>

    <div class="search-bar">
        <form action="/" method="GET" class="search-form">
            <input type="text" name="search" placeholder="Search by title, category, or description..." value="<%= search %>">
            <button type="submit">Search</button>
        </form>
    </div>

    <% if (search) { %>
        <div class="search-info">
            Showing results for "<strong><%= search %></strong>" — <%= books.length %> book(s) found
            &nbsp;·&nbsp; <a href="/" style="color: #6d4c41;">Clear search</a>
        </div>
    <% } %>

    <div class="grid">
        <% if (books.length === 0) { %>
            <div class="no-results">No books found matching your search.</div>
        <% } else { %>
            <% books.forEach(book => { %>
                <div class="book">
                    <a href="/book/<%= book._id %>">
                        <div class="book-img-wrap">
                            <img src="<%= book.coverImage %>" alt="<%= book.title %>">
                        </div>
                        <div class="book-info">
                            <div class="book-category"><%= book.category %></div>
                            <h3><%= book.title %></h3>
                            <div class="price">₹<%= book.price %></div>
                        </div>
                    </a>
                    <div class="book-info" style="padding-top: 0;">
                        <div class="actions">
                            <form action="/add-to-cart/<%= book._id %>" method="POST">
                                <button type="submit" class="btn">Add to Cart</button>
                            </form>
                            <a href="/book/<%= book._id %>" class="btn btn-outline">View</a>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>

    <footer>© VEDIC TALES · HANDCRAFTED WITH DEVOTION</footer>
</body>
</html>
